{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "alert",
  "type": "registry:component",
  "title": "Alert",
  "description": "Contextual inline feedback message with semantic severity levels (info, success, warning, error)",
  "dependencies": [
    "@amezquita/design-system"
  ],
  "registryDependencies": [
    "https://amezquita.dk/r/theme.json"
  ],
  "cssVars": {
    "light": {
      "alert-title-weight": "600",
      "alert-content-gap": "3px",
      "alert-close-offset": "8px",
      "alert-exit-distance": "3px"
    },
    "dark": {
      "alert-title-weight": "600",
      "alert-content-gap": "3px",
      "alert-close-offset": "8px",
      "alert-exit-distance": "3px"
    }
  }
}