{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "switch",
  "type": "registry:component",
  "title": "Switch",
  "description": "Binary toggle for on/off settings; renders as a styled checkbox under the hood",
  "dependencies": [
    "@amezquita/design-system"
  ],
  "registryDependencies": [
    "https://amezquita.dk/r/theme.json"
  ],
  "cssVars": {
    "light": {
      "switch-track-width": "44px",
      "switch-track-height": "24px",
      "switch-track-background": "#A8A29E",
      "switch-track-background-disabled": "#E2DDD9",
      "switch-track-border-radius": "9999px",
      "switch-thumb-size": "16px",
      "switch-thumb-border-radius": "9999px",
      "switch-label-gap": "12px",
      "switch-duration": "200ms"
    },
    "dark": {
      "switch-track-width": "44px",
      "switch-track-height": "24px",
      "switch-track-background": "#78716c",
      "switch-track-background-disabled": "#44403c",
      "switch-track-border-radius": "9999px",
      "switch-thumb-size": "16px",
      "switch-thumb-border-radius": "9999px",
      "switch-label-gap": "12px",
      "switch-duration": "200ms"
    }
  }
}