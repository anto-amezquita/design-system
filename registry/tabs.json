{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tabs",
  "type": "registry:component",
  "title": "Tabs",
  "description": "Segmented view switcher with full keyboard navigation; built on Radix Tabs",
  "dependencies": [
    "@amezquita/design-system"
  ],
  "registryDependencies": [
    "https://amezquita.dk/r/theme.json"
  ],
  "cssVars": {
    "light": {
      "tabs-trigger-padding-x": "16px",
      "tabs-trigger-padding-y": "12px",
      "tabs-trigger-font-weight": "500",
      "tabs-trigger-gap": "4px",
      "tabs-indicator-height": "2px",
      "tabs-pill-border-radius": "4px",
      "tabs-pill-gap": "4px",
      "tabs-sm-trigger-padding-y": "8px",
      "tabs-sm-trigger-padding-x": "12px",
      "tabs-content-padding-top": "16px",
      "tabs-duration": "200ms"
    },
    "dark": {
      "tabs-trigger-padding-x": "16px",
      "tabs-trigger-padding-y": "12px",
      "tabs-trigger-font-weight": "500",
      "tabs-trigger-gap": "4px",
      "tabs-indicator-height": "2px",
      "tabs-pill-border-radius": "4px",
      "tabs-pill-gap": "4px",
      "tabs-sm-trigger-padding-y": "8px",
      "tabs-sm-trigger-padding-x": "12px",
      "tabs-content-padding-top": "16px",
      "tabs-duration": "200ms"
    }
  }
}