{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "table",
  "type": "registry:component",
  "title": "Table",
  "description": "Static data table with semantic header, body, and row structure",
  "dependencies": [
    "@amezquita/design-system"
  ],
  "registryDependencies": [
    "https://amezquita.dk/r/theme.json"
  ],
  "cssVars": {
    "light": {
      "table-cell-padding-x": "16px",
      "table-cell-padding-y": "12px",
      "table-header-font-size": "12px",
      "table-header-font-weight": "600",
      "table-selected-row-background": "#E2DDD9",
      "table-border-radius": "8px",
      "table-sort-icon-gap": "4px"
    },
    "dark": {
      "table-cell-padding-x": "16px",
      "table-cell-padding-y": "12px",
      "table-header-font-size": "12px",
      "table-header-font-weight": "600",
      "table-selected-row-background": "#44403c",
      "table-border-radius": "8px",
      "table-sort-icon-gap": "4px"
    }
  }
}