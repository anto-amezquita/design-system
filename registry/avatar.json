{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "avatar",
  "type": "registry:component",
  "title": "Avatar",
  "description": "User profile picture with fallback to initials when no image is provided",
  "dependencies": [
    "@amezquita/design-system"
  ],
  "registryDependencies": [
    "https://amezquita.dk/r/theme.json"
  ],
  "cssVars": {
    "light": {
      "avatar-size-sm": "24px",
      "avatar-size-md": "32px",
      "avatar-size-lg": "40px",
      "avatar-size-xl": "64px",
      "avatar-ring-width": "2px",
      "avatar-fallback-font-size": "14px",
      "avatar-fallback-font-weight": "600",
      "avatar-group-overlap": "-8px"
    },
    "dark": {
      "avatar-size-sm": "24px",
      "avatar-size-md": "32px",
      "avatar-size-lg": "40px",
      "avatar-size-xl": "64px",
      "avatar-ring-width": "2px",
      "avatar-fallback-font-size": "14px",
      "avatar-fallback-font-weight": "600",
      "avatar-group-overlap": "-8px"
    }
  }
}