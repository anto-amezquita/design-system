{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button",
  "type": "registry:component",
  "title": "Button",
  "description": "Trigger for user actions; renders as `<button>` or `<a>` depending on context",
  "dependencies": [
    "@amezquita/design-system"
  ],
  "registryDependencies": [
    "https://amezquita.dk/r/theme.json",
    "https://amezquita.dk/r/spinner.json"
  ],
  "cssVars": {
    "light": {
      "button-padding-x": "24px",
      "button-padding-y": "12px",
      "button-font-size": "16px",
      "button-font-weight": "500",
      "button-border-radius": "9999px",
      "button-border-width": "1px",
      "button-outline-border-width": "2px",
      "button-duration": "200ms",
      "button-primary-background": "#292524",
      "button-primary-foreground": "#FFFFFF",
      "button-primary-border": "#292524",
      "button-primary-background-hover": "#1C1917",
      "button-secondary-background": "transparent",
      "button-secondary-foreground": "#292524",
      "button-secondary-border": "#292524",
      "button-secondary-background-hover": "#292524",
      "button-secondary-foreground-hover": "#FFFFFF",
      "button-ghost-background": "transparent",
      "button-ghost-foreground": "#0A0A0A",
      "button-ghost-border": "transparent",
      "button-ghost-background-hover": "#F4F0EB",
      "button-icon-gap": "8px",
      "button-icon-size": "20px",
      "button-spinner-duration": "750ms",
      "button-wipe-duration-enter": "550ms",
      "button-wipe-duration-curve": "220ms",
      "button-wipe-duration-exit": "400ms",
      "button-wipe-duration-curve-out": "180ms",
      "button-arrow-nudge": "2px",
      "button-glow-size": "52px"
    },
    "dark": {
      "button-padding-x": "24px",
      "button-padding-y": "12px",
      "button-font-size": "16px",
      "button-font-weight": "500",
      "button-border-radius": "9999px",
      "button-border-width": "1px",
      "button-outline-border-width": "2px",
      "button-duration": "200ms",
      "button-primary-background": "#f4f0eb",
      "button-primary-foreground": "#1c1917",
      "button-primary-border": "#f4f0eb",
      "button-primary-background-hover": "#fafaf9",
      "button-secondary-background": "transparent",
      "button-secondary-foreground": "#a8a29e",
      "button-secondary-border": "#a8a29e",
      "button-secondary-background-hover": "#a8a29e",
      "button-secondary-foreground-hover": "#1c1917",
      "button-ghost-background": "transparent",
      "button-ghost-foreground": "#fafaf9",
      "button-ghost-border": "transparent",
      "button-ghost-background-hover": "#292524",
      "button-icon-gap": "8px",
      "button-icon-size": "20px",
      "button-spinner-duration": "750ms",
      "button-wipe-duration-enter": "550ms",
      "button-wipe-duration-curve": "220ms",
      "button-wipe-duration-exit": "400ms",
      "button-wipe-duration-curve-out": "180ms",
      "button-arrow-nudge": "2px",
      "button-glow-size": "52px"
    }
  }
}