{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "checkbox",
  "type": "registry:component",
  "title": "Checkbox",
  "description": "Single boolean selection with an associated label; supports indeterminate state",
  "dependencies": [
    "@amezquita/design-system"
  ],
  "registryDependencies": [
    "https://amezquita.dk/r/theme.json"
  ],
  "cssVars": {
    "light": {
      "checkbox-size": "24px",
      "checkbox-border": "#A8A29E",
      "checkbox-border-width": "1px",
      "checkbox-border-radius": "4px",
      "checkbox-label-gap": "12px"
    },
    "dark": {
      "checkbox-size": "24px",
      "checkbox-border": "#78716c",
      "checkbox-border-width": "1px",
      "checkbox-border-radius": "4px",
      "checkbox-label-gap": "12px"
    }
  }
}