{
  "name": "@amezquita/design-system",
  "version": "1.6.7",
  "description": "Token-first, multi-brand design system — DTCG tokens, Style Dictionary, CI-enforced linting/contrast/accessibility, Figma sync, and agent-safe governance.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anto-amezquita/design-system.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "components",
    "lib",
    "hooks",
    "tokens/global.json",
    "tokens/brands",
    "tokens/components",
    "tokens/component-registry.json",
    "tokens/token-reference.json",
    "tokens/fonts.json",
    "tokens/changelog.json",
    "styles/brands",
    "styles/reset.css",
    "llms.txt",
    "llms-full.txt",
    "tokens.json",
    "skills",
    "registry",
    "docs/components",
    "AGENTS.md",
    "CHANGELOG.md",
    "decisions/*.md"
  ],
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish",
    "tokens": "node scripts/build-dependency-graph.mjs && node sd.config.mjs",
    "tokens:watch": "node --watch sd.config.mjs",
    "tokens:lint": "node scripts/lint-tokens.mjs",
    "tokens:lint-architecture": "node scripts/lint-token-architecture.mjs",
    "tokens:graph": "node scripts/build-dependency-graph.mjs",
    "tokens:audit": "node scripts/audit-tokens.mjs",
    "tokens:contrast": "node scripts/check-contrast.mjs",
    "tokens:dtcg": "node scripts/migrate-to-dtcg.mjs",
    "figma:status": "node scripts/figma-status.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "node scripts/check-consumer-types.mjs",
    "test": "vitest run",
    "validate": "npm run tokens:lint && npm run tokens:lint-architecture && npm run tokens:contrast && node scripts/check-components-doc.mjs && node scripts/check-stories.mjs && node scripts/check-client-directives.mjs && npm run typecheck && npm run typecheck:consumer && npm run test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --stats-json",
    "chromatic": "chromatic --build-script-name=build-storybook"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "gsap": "^3.15.0",
    "markdown-to-jsx": "9.10.3"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "chromatic": "^18.0.1",
    "glob": "13.0.6",
    "playwright": "1.62.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.21.1",
    "storybook": "^10.3.6",
    "style-dictionary": "^5.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
