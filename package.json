{
  "name": "@amezquita/design-system",
  "version": "0.1.1",
  "description": "Token-first, multi-brand design system — DTCG tokens, Style Dictionary, CI-enforced linting/contrast/accessibility, Figma sync, and agent-safe governance.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anto-amezquita/design-system.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "components",
    "lib",
    "hooks",
    "styles/brands",
    "styles/reset.css"
  ],
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "tokens": "node scripts/build-dependency-graph.mjs && node sd.config.mjs",
    "tokens:watch": "node --watch sd.config.mjs",
    "tokens:lint": "node scripts/lint-tokens.mjs",
    "tokens:graph": "node scripts/build-dependency-graph.mjs",
    "tokens:contrast": "node scripts/check-contrast.mjs",
    "tokens:dtcg": "node scripts/migrate-to-dtcg.mjs",
    "figma:status": "node scripts/figma-status.mjs",
    "a11y": "npm run build-storybook && npm run a11y:stories",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --stats-json",
    "chromatic": "chromatic --build-script-name=build-storybook",
    "a11y:stories": "concurrently -k -s first -n SB,TEST \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006\""
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/test-runner": "^0.24.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "chromatic": "^18.0.1",
    "concurrently": "^10.0.3",
    "glob": "^11.0.0",
    "http-server": "^14.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^10.3.6",
    "style-dictionary": "^5.4.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "wait-on": "^9.0.10",
    "@changesets/cli": "^2.29.7"
  }
}
