node_modules/
*.tsbuildinfo

*storybook.log
storybook-static/
.DS_Store

# Vitest browser-mode debug output — regenerated per run, not committed
__screenshots__/
.vitest-attachments/

# CI script output — generated on each run, not committed
a11y-report.json
token-violations.json
token-architecture-violations.json
contrast-failures.json
docs/token-audit.json

# Claude Code local overrides. .claude/settings.json IS committed (the hook
# pair, ADR 0009); these two are per-machine — settings.local.json holds
# permission allowlists that should never be shared.
.claude/settings.local.json
.claude/*.local.json

# Proposed decision drafts — unreviewed harvested evidence, never committed.
# Accepting one means rewriting it as decisions/NNNN-<slug>.md by hand.
# See decisions/proposed/README.md and decisions/0009-*.md.
decisions/proposed/*.draft.md

# /design-sync working state - staged scripts, build output, reference
# storybook, caches. The durable sync inputs (.design-sync/config.json,
# NOTES.md, conventions.md, previews/, fonts/, the two .mjs scripts) ARE committed.
.ds-sync/
ds-bundle/
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
