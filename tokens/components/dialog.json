{
  "dialog-max-width": {
    "$value": "{size.dialog-md}",
    "$type": "dimension",
    "$description": "Width of a default (md) Dialog: 560px.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "dialog-close-size": {
    "$value": "{size.icon-interactive}",
    "$type": "dimension",
    "$description": "Hit area of a Dialog's close button.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "dialog-max-width-sm": {
    "$value": "{size.dialog-sm}",
    "$type": "dimension",
    "$description": "Width of a small Dialog: 480px.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "dialog-max-width-lg": {
    "$value": "{size.dialog-lg}",
    "$type": "dimension",
    "$description": "Width of a large Dialog: 720px.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
