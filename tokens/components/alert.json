{
  "alert-title-weight": {
    "$value": "{font-weight.semibold}",
    "$type": "fontWeight",
    "$description": "Weight of an Alert's title.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One of 5 semibold uses across different functions, below decisions/0004's 3+-shared-function bar."
    }
  },
  "alert-content-gap": {
    "$value": "{space.1}",
    "$type": "dimension",
    "$description": "Space between an Alert's title and its message.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "alert-close-offset": {
    "$value": "{space.2}",
    "$type": "dimension",
    "$description": "Pulls an Alert's close button up so it lines up with the title.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "alert-exit-distance": {
    "$value": "{space.1}",
    "$type": "dimension",
    "$description": "How far a dismissed Alert slides up as it fades out.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  }
}
