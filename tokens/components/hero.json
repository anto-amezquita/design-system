{
  "hero-padding-y": {
    "$value": "{space.12}",
    "$type": "dimension",
    "$description": "Vertical padding of a Hero section.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "Not part of either container-padding group — held out and explicitly left untouched, see decisions/0004."
    }
  },
  "hero-eyebrow-size": {
    "$value": "{font-size.sm}",
    "$type": "dimension",
    "$description": "Text size of the Hero eyebrow.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "hero-eyebrow-weight": {
    "$value": "{font-weight.semibold}",
    "$type": "fontWeight",
    "$description": "Weight of the Hero eyebrow.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One of 5 semibold uses across different functions, below decisions/0004's 3+-shared-function bar."
    }
  },
  "hero-eyebrow-spacing": {
    "$value": "0.01em",
    "$type": "dimension",
    "$description": "Tracking of the Hero eyebrow."
  },
  "hero-title-weight": {
    "$value": "{font-weight.extrabold}",
    "$type": "fontWeight",
    "$description": "Weight of the Hero title.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "hero-lead-size": {
    "$value": "{font-size.emphasis}",
    "$type": "dimension",
    "$description": "Text size of the Hero lead paragraph.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "hero-max-width": {
    "$value": "800px",
    "$type": "dimension",
    "$description": "Maximum width of a Hero's content."
  },
  "hero-lead-max-width": {
    "$value": "60ch",
    "$type": "dimension",
    "$description": "Maximum line length of the Hero lead paragraph."
  }
}
