{
  "datatable-gap": {
    "$value": "{space.4}",
    "$type": "dimension",
    "$description": "Space between a DataTable's toolbar, table and footer.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "datatable-footer-gap": {
    "$value": "{space.4}",
    "$type": "dimension",
    "$description": "Space between items in a DataTable's footer.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "datatable-filter-cell-padding-y": {
    "$value": "{space.2}",
    "$type": "dimension",
    "$description": "Vertical padding of the filter row's cells in a DataTable.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  }
}
