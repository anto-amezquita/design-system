{
  "tooltip-font-size": {
    "$value": "{font-size.xs}",
    "$type": "dimension",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "tooltip-font-weight": {
    "$value": "{font-weight.medium}",
    "$type": "fontWeight",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "Doesn't share function with the font-weight-control group, see decisions/0004."
    }
  },
  "tooltip-border-radius": {
    "$value": "{border-radius.sm}",
    "$type": "dimension",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "Shares value with border-radius-interactive but isn't an interactive component — deliberately left, see decisions/0004."
    }
  },
  "tooltip-max-width": {
    "$value": "260px",
    "$type": "dimension"
  },
  "tooltip-arrow-size": {
    "$value": "{space.2}",
    "$type": "dimension",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "tooltip-delay-duration": {
    "$value": "400",
    "$type": "number"
  },
  "tooltip-side-offset": {
    "$value": "6",
    "$type": "number"
  }
}
