{
  "accordion-content-padding-x": {
    "$value": "{space.6}",
    "$type": "dimension",
    "$description": "Horizontal padding of an open Accordion panel.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "accordion-content-padding-bottom": {
    "$value": "{space.6}",
    "$type": "dimension",
    "$description": "Bottom padding of an open Accordion panel.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "accordion-duration-expand": {
    "$value": "{duration.expand}",
    "$type": "duration",
    "$description": "How long an Accordion panel takes to open.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "accordion-duration-collapse": {
    "$value": "{duration.collapse}",
    "$type": "duration",
    "$description": "How long an Accordion panel takes to close. Shorter than opening, so closing feels immediate.",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  }
}
