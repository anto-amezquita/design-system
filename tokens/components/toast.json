{
  "toast-max-width": {
    "$value": "380px",
    "$type": "dimension"
  },
  "toast-title-weight": {
    "$value": "{font-weight.semibold}",
    "$type": "fontWeight",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One of 5 semibold uses across different functions, below decisions/0004's 3+-shared-function bar."
    }
  },
  "toast-font-size": {
    "$value": "{font-size.sm}",
    "$type": "dimension",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "toast-accent-width": {
    "$value": "4px",
    "$type": "dimension"
  },
  "toast-viewport-inset": {
    "$value": "{space.5}",
    "$type": "dimension",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  },
  "toast-close-offset": {
    "$value": "{space.2}",
    "$type": "dimension",
    "$extensions": {
      "amezquita.lint-ignore": ["no-collapsible-token"],
      "amezquita.reason": "One-off, below decisions/0004's 3+-shared-function bar."
    }
  }
}
